# ============================================================
# ASHA Platform API — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ============================================================

# ----------------------------------------------------------
# Supabase
# ----------------------------------------------------------
# Project URL from Supabase dashboard (Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role secret key — grants full DB access; keep secret
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret used to verify user tokens (Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ----------------------------------------------------------
# AI Provider
# ----------------------------------------------------------
# One of: openai | gemini | anthropic | groq | ollama
AI_PROVIDER=openai

# Model name passed to the chosen provider
AI_MODEL=gpt-4o-mini

# Provider API key (name varies; add the relevant one below)
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# GROQ_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# JSON array of allowed origins for browser requests
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG locally, INFO in production
LOG_LEVEL=DEBUG
