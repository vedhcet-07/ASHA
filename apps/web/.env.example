# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL for the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — safe to expose in browser
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Sentry DSN for frontend error tracking (leave blank to disable Sentry)
VITE_SENTRY_DSN=
